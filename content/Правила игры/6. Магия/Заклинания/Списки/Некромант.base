filters:
  and:
    - file.inFolder("Правила игры/6. Магия/Заклинания")
views:
  - type: list
    name: Заклинания некроманта первого круга
    filters:
      and:
        - ne == 1
    order:
      - file.name
    markers: number
  - type: list
    name: Заклинания некроманта второго круга
    filters:
      and:
        - ne == 2
    order:
      - file.name
    markers: number
  - type: list
    name: Заклинания некроманта третьего круга
    filters:
      and:
        - ne == 3
    order:
      - file.name
    markers: number
  - type: list
    name: Заклинания некроманта четвертого круга
    filters:
      and:
        - ne == 4
    order:
      - file.name
    markers: number
  - type: list
    name: Заклинания некроманта пятого круга
    filters:
      and:
        - ne == 5
    order:
      - file.name
    markers: number
  - type: list
    name: Заклинания некроманта шестого круга
    filters:
      and:
        - ne == 6
    order:
      - file.name
    markers: number
  - type: list
    name: View
    filters:
      and:
        - "!ne.isEmpty()"
    groupBy:
      property: ne
      direction: ASC
