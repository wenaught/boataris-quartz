filters:
  and:
    - file.inFolder("Правила игры/6. Магия/Заклинания")
    - "!dr.isEmpty()"
views:
  - type: list
    name: Заклинания друида первого круга
    filters:
      and:
        - dr == 1
    order:
      - file.name
    markers: number
  - type: list
    name: Заклинания друида второго круга
    filters:
      and:
        - dr == 2
    order:
      - file.name
    markers: number
  - type: list
    name: Заклинания друида третьего круга
    filters:
      and:
        - dr == 3
    order:
      - file.name
    markers: number
  - type: list
    name: Заклинания друида четвертого круга
    filters:
      and:
        - dr == 4
    order:
      - file.name
    markers: number
  - type: list
    name: Заклинания друида пятого круга
    filters:
      and:
        - dr == 5
    order:
      - file.name
    markers: number
  - type: list
    name: Заклинания друида шестого круга
    filters:
      and:
        - dr == 6
    order:
      - file.name
    markers: number
